module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

#include	"mailfiles.h"

export module mailfiles_mag ;

export {
    template<typename ... Args>
    inline int mailfiles_magic(mailfiles *op,Args ... args) noex {
	int		rs = SR_FAULT ;
	if (op && (args && ...)) {
	    rs = (op->magval == MAILFILES_MAGIC) ? SR_OK : SR_NOTOPEN ;
	}
	return rs ;
    } /* end subroutine (mailfiles_magval) */
} /* end export */


