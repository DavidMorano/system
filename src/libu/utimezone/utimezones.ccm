/*******************************************************************************

	Names:
	utimezone

	Description:
	All of the UNIX® system calls that use (operate on) a
	file-descroptor.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */

#include	"utimezones.hh"

export module utimezones ;

export {
    struct utimezonestdflags {
	uint		fintr:1 ;	/* request interrupts to return */
    } ; /* end struct (utimezonestdflags) */
    struct utimezonestd {
	utimezonestdflags	fl ;
	utimezonestd() noex { 
	    fl = {} ;
	} ; /* end ctor */
	virtual int callstd() noex = 0 ;
	operator int () noex ;
    } ; /* end struct (usyscallbase) */
} /* end export */


