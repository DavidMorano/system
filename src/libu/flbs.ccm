/******************************************************************************

	Name:
	flbs{x}

	Description:
	Find the last bit set in an integer.

	Synopsis:
	template<integral T> int flbs{x}(T v) noex
	int flbs{x}(X v) noex

	Arguments:
	{x}		'int', 'long', 'longlong'
	v		supplied integer value

	Returns:
	-               the last bit that was set

******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<climits>		/* |CHAR_BIT| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<cstdintx>
#include	<concepts>		/* |integral(3c++)| */
#include	<bit>			/* |countl_zero(3c++)| */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<localmisc.h>

#include	"nextpowtwo.h"

export module flbs ;

/* local defines */


/* imported namespaces */

using std::integral ;			/* concept */
using std::countl_zero ;		/* subroutine-template */


/* local typedefs */


/* external subroutines */


/* external variables */


/* local structures */


/* forward references */

export {
    template<integral T> constexpr int flbs(T v) noex {
	int		bn = -1 ; /* return-value */
	if (v) {
	    cint nbit = (szof(T) * CHAR_BIT) ;
	    int nc{} ;
	    if_constexpr (szof(T) == szof(int)) {
	        uint	uv = uint(v) ;
	        {
	            nc = countl_zero(uv) ;
	        }
	    } else if_constexpr (szof(T) == szof(long)) {
	        ulong uv = ulong(v) ;
	        {
	            nc = countl_zero(uv) ;
	        }
	    } else if_constexpr (szof(T) == szof(longlong)) {
	        ulonglong uv = ulonglong(v) ;
	        {
	            nc = countl_zero(uv) ;
	        }
	    } /* end if_constexpr */
	    bn = (nbit - nc - 1) ;
	} /* end if (non-zero positive) */
	return bn ;
    } /* end subroutine-template (flbs) */
} /* end export */

export {
    extern "C" {
        int flbsi(int v) noex {
	    return flbs(v) ;
        }
        int flbsl(long v) noex {
	    return flbs(v) ;
        }
        int flbsll(longlong v) noex {
	    return flbs(v) ;
        }
    } /* end extern (C) */
} /* end export */


