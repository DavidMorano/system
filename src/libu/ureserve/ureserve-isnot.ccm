/*******************************************************************************

  	Module:
	ureserve:isnot

	Description:
	This module provides miscellaneous UNIX® or other
	common (library oriented) subroutines.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* |UCHAR_MAX| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<vector>
#include	<string>
#include	<iostream>
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<usysrets.h>
#include	<localmisc.h>

export module ureserve:isnot ;

using std::vector ;			/* type */

export {
    bool isoneof(cint *,int) noex ;
    inline bool isOneOf(cint *rsa,int rs) noex {
	    return isoneof(rsa,rs) ;
    }
} /* end export */

export {
    bool isnotaccess(int) noex ;
    bool isnotlib(int) noex ;
    bool isnotpresent(int) noex ;
    bool isnotsupport(int) noex ;
    bool isnotterm(int) noex ;
    bool isnotvalid(int) noex ;
}

export {
    inline bool isNotAccess(int rc) noex {
        return isnotaccess(rc) ;
    }
    inline bool isNotLib(int rc) noex {
        return isnotlib(rc) ;
    }
    inline bool isNotPresent(int rc) noex {
	return isnotpresent(rc) ;
    }
    inline bool isNotSupport(int rc) noex {
    	return isnotsupport(rc) ;
    }
    inline bool isNotTerm(int rc) noex {
    	return isnotterm(rc) ;
    }
    inline bool isNotValid(int rc) noex {
    	return isnotvalid(rc) ;
    }
    inline bool isInvalid(int rc) noex {
    	return isnotvalid(rc) ;
    }
} /* end export */


