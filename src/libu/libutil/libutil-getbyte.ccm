/*******************************************************************************

  	Group:
	getbuyte

	Description:
	Retrive a byte from a given type source integer.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* CSTD |UCHAR_MAX| */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<concepts>		/* C++CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

export module libutil:getbyte ;

using std::integral ;			/* concept */

export {
    template<integral T> uchar getbyte(T w,int n) noex {
    	return ucharconv(w >> (n * CHAR_BIT)) ;
    } /* end subroutine-template (getbyte) */
} /* end export */


