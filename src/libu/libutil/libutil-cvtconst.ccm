module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* |INT_MAX| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<cstdarg>
#include	<cstring>		/* |strlen(3c)| + |strnlen(3c)| */
#include	<algorithm>		/* |min(C++)| */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>

export module libutil:cvtconst  ;

export {
    template<typename T> constexpr T cvtconst(T val) noex {
        const T cval = val ;
        return cval ;
    }
} /* end export */


