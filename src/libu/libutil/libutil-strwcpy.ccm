module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* |INT_MAX| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<cstdarg>
#include	<cstring>		/* |stpcpy(3c)| */
#include	<algorithm>		/* |min(C++)| */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<localmisc.h>

export module libutil:strwcpy ;

export {
    namespace libu {
        constexpr inline char *strwcpy(char *dp,cchar *sp,int sl = -1) noex {
    	    if (dp && sp) {
	        if (sl >= 0) {
	            while (sl-- && *sp) *dp++ = *sp++ ;
	            *dp = '\0' ;
	        } else {
	            dp = stpcpy(dp,sp) ;
	        } /* end if */
	    } else {
	        dp = nullptr ;
	    } /* end if (non-null) */
	    return dp ;
        } /* end subroutine (strwcpy) */
    } /* end namespace (libu) */
} /* end export */


