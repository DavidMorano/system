module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* CSTD |INT_MAX| */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cstdarg>		/* CSTD */
#include	<cstring>		/* CSTD |strlen(3c)| + |strnlen(3c)| */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

export module libutil:strlen ;

export {
    constexpr inline int cstrnlen(cchar *sp,int sl = -1) noex {
	int len = -1 ;
	if (sp) ylikely {
    	    cchar *cp = sp ;
	    while (sl && *cp++) {
	        sl -= 1 ;
	    } /* end */
	    len = intconv(cp - sp) ;
	} /* end if (non-null) */
	return len ;
    } /* end subroutine (vstrnlen) */
    constexpr inline int cstrlen(cchar *sp) noex {
	int len = -1 ;
	if (sp) ylikely {
    	    len = 0 ;
	    while (sp[len]) len += 1 ;
	} /* end if (non-null) */
	return len ;
    } /* end subroutine */
    constexpr inline int xstrnlen(cchar *sp,int sl) noex {
    	int		len = 1 ;
	if (sp) ylikely {
	    if consteval {
	        if (sl >= 0) {
	            len = cstrnlen(sp,sl) ;
	        } else {
	            len = cstrlen(sp) ;
	        }
	    } else {
	        if (sl >= 0) {
    	            csize srcsize = size_t(sl) ;
	            len = intconv(strnlen(sp,srcsize)) ;
	        } else {
	            len = intconv(strlen(sp)) ;
	        }
	    } /* end if (consteval) */
	} /* end if (non-null) */
    	return len ;
    } /* end subroutine (xstrnlen) */
    constexpr inline int xstrlen(cchar *sp,int sl = -1) noex {
	return xstrnlen(sp,sl) ;
    } /* end subroutine (cstrlen) */
} /* end export */


