module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* |INT_MAX| + |UCHAR_MAX| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<cstdarg>
#include	<cstring>		/* |strlen(3c)| + |strnlen(3c)| */
#include	<algorithm>		/* |min(C++)| */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<localmisc.h>

export module libutil:strcmp ;

export {
    constexpr int cstrcmp(cchar *s1,cchar *s2) noex {
	while (*s1 && *s2 && (*s1 == *s2)) {
	    s1++ ;
	    s2++ ;
	} /* end while */
	return (int(*s1 & UCHAR_MAX) - int(*s2 & UCHAR_MAX)) ;
    } /* end subroutine (cstrcmp) */
} /* end export */


