module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* CSTD |INT_MAX| */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cstdarg>		/* CSTD */
#include	<cstring>		/* CSTD *|strlen(3c)| + |strnlen(3c)| */
#include	<algorithm>		/* C++STD |min(C++)| */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

export module libutil:getlen ;

export {
    template<typename T> 
    constexpr inline int getlen(const T *ap,int al = -1) noex {
	int		i = -1 ; /* return-value and multiple */
	if (ap) ylikely {
	    i = 0 ; 
	    if (al >= 0) {
		i = al ;
	    } else {
	        while (al-- && ap[i]) i += 1 ;
	    }
	} /* end if (non-null) */
	return i ;
    } /* end subroutine-template (getlen) */
} /* end export */


