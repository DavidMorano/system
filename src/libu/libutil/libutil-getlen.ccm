module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* |INT_MAX| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<cstdarg>
#include	<cstring>		/* |strlen(3c)| + |strnlen(3c)| */
#include	<algorithm>		/* |min(C++)| */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>

export module libutil:getlen ;

export {
    template<typename T> 
    constexpr inline int getlen(const T *ap,int al = -1) noex {
	int		i = -1 ; /* return-value and multiple */
	if (ap) {
	    i = 0 ; 
	    if (al >= 0) {
		i = al ;
	    } else {
	        while (al-- && ap[i]) i += 1 ;
	    }
	} /* end if (non-null) */
	return i ;
    } /* end subroutine-template (getlen) */
} /* end export */


