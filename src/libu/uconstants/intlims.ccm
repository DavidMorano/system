module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>

export module intlims ;

export {
    template<typename T> struct intlims {
	T max ;
	T min ;
	consteval intlimes() noex {
	    min = 0 ;
	    max = 0 ;
	} ;
	consteval T operator () () noex ;
    } ; /* end struct (intlims) */
} /* end export */

constexpr intlimes<long>	intlim ;


	constexpr intlimes<long>	tst ;
	constexpr intlimes<T>		tst ;
	a = tst.min ;

	a = tst<long>() ;


	a = intlim<long>.min ;
	a = intlim<long>.max ;


