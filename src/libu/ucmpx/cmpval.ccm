module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<concepts>		/* CSTD */
#include	<numeric>		/* CSTD (saturating arithmetic) */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<intsat.h>		/* LIBU */

export module cmpval ;

template<typename T> local int cmpvalsx(T v1,T v2) noex {
    	return intsat(v1 - v2) ;
} /* end subroutine-template (cmpvalsx) */

template<typename T> local int cmpvalux(T v1,T v2) noex {
    	int rc = 0 ;
	if (v1 != v2) {
	    rc = (v1 > v2) ? +1 : -1 ;
	}
	return rc ;
} /* end subroutine-template (cmpvalux) */

export {
    int cmpvalsc	(char v1,char v2)		noex {
	return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpvalss	(short v1,short v2)		noex {
	return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpvalsi	(int v1,int v2)			noex {
	return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpvalsl	(long v1,long v2)		noex {
	return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpvalsll	(longlong v1,longlong v2)	noex {
	return cmpvalsx(v1,v2) ;
    } /* end */
} /* end export */

export {
    int cmpvaluc	(uchar v1,uchar v2)		noex {
	return cmpvalux(v1,v2) ;
    } /* end */
    int cmpvalus	(ushort v1,ushort v2)		noex {
	return cmpvalux(v1,v2) ;
    } /* end */
    int cmpvalui	(uint v1,uint v2)		noex {
	return cmpvalux(v1,v2) ;
    } /* end */
    int cmpvalul	(ulong v1,ulong v2)		noex {
	return cmpvalux(v1,v2) ;
    } /* end */
    int cmpvalull	(ulonglong v1,ulonglong v2)	noex {
	return cmpvalux(v1,v2) ;
    } /* end */
} /* end export */

export {
    int cmpval	(char v1,char v2)		noex {
        return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpval	(short v1,short v2)		noex {
        return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpval	(int v1,int v2)			noex {
        return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpval	(long v1,long v2)		noex {
        return cmpvalsx(v1,v2) ;
    } /* end */
    int cmpval	(longlong v1,longlong v2) 	noex {
        return cmpvalsx(v1,v2) ;
    } /* end */
} /* end export */

export {
    int cmpval	(uchar v1,uchar v2)		noex {
        return cmpvalux(v1,v2) ;
    } /* end */
    int cmpval	(ushort v1,ushort v2)		noex {
        return cmpvalux(v1,v2) ;
    } /* end */
    int cmpval	(uint v1,uint v2)		noex {
        return cmpvalux(v1,v2) ;
    } /* end */
    int cmpval	(ulong v1,ulong v2)		noex {
        return cmpvalux(v1,v2) ;
    } /* end */
    int cmpval	(ulonglong v1,ulonglong v2) 	noex {
        return cmpvalux(v1,v2) ;
    } /* end */
} /* end export */


