module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstddef>
#include	<cstdlib>
#include	<cstdint>
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<ascii.h>

export module ischx ;

export {
    extern bool	ischalpha	(int) noex attrpure ;
    extern bool	ischalnum	(int) noex attrpure ;
    extern bool	ischwhite	(int) noex attrpure ;
    extern bool	ischlower	(int) noex attrpure ;
    extern bool	ischupper	(int) noex attrpure ;
} /* end export */

export {
    inline bool	ischdigit	(int ch) noex attrconst {
	return (ch >= '0') && (ch <= '9') ;
    }
    inline bool	ischdigex	(int ch) noex attrconst {
	bool f = false ;
	f = f || ((ch >= '0') && (ch <= '9')) ;
	f = f || ((ch >= 'A') && (ch <= 'F')) ;
	f = f || ((ch >= 'a') && (ch <= 'f')) ;
	return f ;
    }
    inline bool	ischblank	(int ch) noex attrconst {
	return (ch == CH_SP) || (ch == CH_TAB) ;
    }
    inline bool	ischzero	(int ch) noex attrconst {
	return (ch == '0') ;
    }
    inline bool	ischpl		(int ch) noex attrconst {
	return (ch == '+') ;
    }
    inline bool	ischmi		(int ch) noex attrconst {
	return (ch == '-') ;
    }
    inline bool	ischpm		(int ch) noex attrconst {
	return (ch == '+') || (ch == '-') ;
    }
    inline bool	ischme		(int ch) noex attrconst {
	return (ch == '+') || (ch == '-') || (ch == '!') ;
    }
} /* end export */


