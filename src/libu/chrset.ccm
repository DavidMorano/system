/*******************************************************************************

	Object:
	chrset

	Description:
	Provide operations on a character-bit-set.

	Synopsis:
	int chrset::load(cchar *ss) noex
	int chrset::tst(int ch) const noex
	int chrset::set(int ch) noex
	int chrset::clr(int ch) noex

	Arguments:
	ss		c-string of character-set to load
	ch		character to use for particular operation

	Returns:
	==1		for test: character was present
	==0		for test: character was not present
	<0		error (system-return)

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* |UCHAR_MAX| + |CHAR_BIT| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<concepts>
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<usysrets.h>
#include	<stdintx.h>
#include	<baops.h>
#include	<localmisc.h>

export module chrset ;

typedef ulong	word_t ;

local cint	nbits = (UCHAR_MAX + 1) ;

local cint	nwords = ((UCHAR_MAX + 1) / (szof(word_t) * CHAR_BIT)) ;

export {
    struct chrset {
	word_t		bs[nwords] = {} ;	/* 32 bytes (4 words) */
	int load(cchar *) noex ;
	chrset() = default ;
	chrset(cchar *ss) noex {
	    load(ss) ;
	} ;
	chrset(int ch) noex {
	    baset(bs,ch) ;
	} ;
	int set(int) noex ;
	int clr(int) noex ;
	int tst(int) const noex ;
	int operator [] (int ch) const noex {
	    return tst(ch) ;
	} ;
    } ; /* end struct (chrset) */
} /* end export */

int chrset::load(cchar *ss) noex {
    	int		rs = SR_FAULT ;
	if (ss) {
	    rs = SR_OK ;
	    for (int ch ; ((ch = (*ss & UCHAR_MAX))) ; ss += 1) {
		if (ch < nbits) {
		    baset(bs,ch) ;
		} else {
		    rs = SR_INVALID ;
		    break ;
		}
	    } /* end for */
	} /* end if (non-null) */
	return rs ;
} /* end method (chrset::load) */

int chrset::tst(int ch) const noex {
    	int rs = SR_INVALID ;
	if ((ch >= 0) && (ch < nbits)) {
	    rs = bool(batst(bs,ch)) ;
	}
	return rs ;
} /* end method (chrset::tst) */

int chrset::set(int ch) noex {
    	int rs = SR_INVALID ;
	if ((ch >= 0) && (ch < nbits)) {
	    rs = SR_OK ;
	    baset(bs,ch) ;
	}
	return rs ;
} /* end method (chrset::set) */

int chrset::clr(int ch) noex {
    	int rs = SR_INVALID ;
	if ((ch >= 0) && (ch < nbits)) {
	    rs = SR_OK ;
	    baclr(bs,ch) ;
	}
	return rs ;
} /* end method (chrset::clr) */


