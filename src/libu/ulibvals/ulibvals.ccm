/*******************************************************************************

  	Module:
	ulibvals

	Description:
	This module contains a structure (ULIBVALER) that itself
	contains various system related integer values.

	Synopsis:
	import ulibvals
	ulibval.{x}

	Returns:
	>=0		requested value
	<0		error (system-return)

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU |{xxx}BUFLEN| */

export module ulibvals ;

export {
    struct ulibvaler ;
    enum ulibvalmems {
	ulibvalmem_endianval,
	ulibvalmem_pagesz,
	ulibvalmem_clktck,
	ulibvalmem_maxbase,
	ulibvalmem_maxpid,
	ulibvalmem_maxarg,
	ulibvalmem_maxline,
	ulibvalmem_maxlink,
	ulibvalmem_maxlogin,
	ulibvalmem_maxsymloop,
	ulibvalmem_maxsymbol,
	ulibvalmem_maxgroups,
	ulibvalmem_maxnamelen,
	ulibvalmem_maxpathlen,
	ulibvalmem_maxmsglen,
	ulibvalmem_maxsysuid,
	ulibvalmem_maxtzname,
	ulibvalmem_maxtzabbr,
	ulibvalmem_nodenamelen,
	ulibvalmem_usernamelen,
	ulibvalmem_groupnamelen,
	ulibvalmem_projnamelen,
	ulibvalmem_protnamelen,
	ulibvalmem_hostnamelen,
	ulibvalmem_servnamelen,
	ulibvalmem_binbuflen,
	ulibvalmem_octbuflen,
	ulibvalmem_decbuflen,
	ulibvalmem_hexbuflen,
	ulibvalmem_digbuflen,
	ulibvalmem_overlast
    } ; /* end enum (ulibvalmem) */
    struct ulibvaler_co {
	int		val ;
	ulibvalmems	w ;
	ulibvaler_co() = delete ;
	ulibvaler_co(ulibvalmems ªw) noex : val(0), w(ªw) { } ; 
    	operator int () noex ;
	int operator () () noex {
	    return operator int () ;
	} ; /* end */
    } ; /* end struct (ulibvaler_co) */
    struct ulibvaler {
	static ulibvaler_co	endianval ;
	static ulibvaler_co	pagesz ;
	static ulibvaler_co	clktck ;
	static ulibvaler_co	maxbase ;
	static ulibvaler_co	maxpid ;	/* max PID value */
	static ulibvaler_co	maxarg ;
	static ulibvaler_co	maxline ;
	static ulibvaler_co	maxlink ;
	static ulibvaler_co	maxlogin ;
	static ulibvaler_co	maxsymloop ;
	static ulibvaler_co	maxsymbol ;
	static ulibvaler_co	maxgroups ;
	static ulibvaler_co	maxnamelen ;	/* file-system */
	static ulibvaler_co	maxpathlen ;	/* file-system */
	static ulibvaler_co	maxmsglen ;	/* Maximum-Message-Length */
	static ulibvaler_co	maxsysuid ;	/* maximum-system-UID */
	static ulibvaler_co	maxtzname ;	/* maximum tz-name length */
	static ulibvaler_co	maxtzabbr ;	/* maximum tz-abbr length */
	static ulibvaler_co	nodenamelen ;	/* name system node */
	static ulibvaler_co	usernamelen ;	/* name system user */
	static ulibvaler_co	groupnamelen ;	/* name system group */
	static ulibvaler_co	projnamelen ;	/* name system project */
	static ulibvaler_co	protnamelen ;	/* name network protocol */
	static ulibvaler_co	hostnamelen ;	/* name network host*/
	static ulibvaler_co	servnamelen ;	/* name network serice */
	static ulibvaler_co	binbuflen ;	/* for |int256_t| */
	static ulibvaler_co	octbuflen ;	/* for |int256_t| */
	static ulibvaler_co	decbuflen ;	/* for |int256_t| */
	static ulibvaler_co	hexbuflen ;	/* for |int256_t| */
	static ulibvaler_co	digbuflen ;	/* for |int256_t| */
	operator int () noex ;
    } ; /* end struct (ulibvaler) */
} /* end export */

export {
    extern ulibvaler		ulibval ;
} /* end extern */


