module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<algorithm>		/* C++STD |sort(3c++)| */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */

#include	"usysconfcheck.hh"

export module usysconfcheck ;

using std::partition_point ;		/* subroutine-template */

export {
    enum usysconfitems {
	dataitem_pagesz,
	dataitem_maxpid,
	dataitem_maxarg,
	dataitem_maxline,
	dataitem_maxlink,		/* hard links */
	dataitem_maxlogin,
	dataitem_maxgroups,
	dataitem_symlinks,		/* symbolic (soft) links */
	dataitem_maxsymbol,
	dataitem_maxnamelen,
	dataitem_maxpathlen,
	dataitem_maxnodename,		/* name */
	dataitem_maxusername,		/* name */
	dataitem_maxgroupname,		/* name */
	dataitem_maxprojectname,	/* name */
	dataitem_maxprot,		/* name */
	dataitem_maxnetw,		/* name */
	dataitem_maxhost,		/* name */
	dataitem_maxserv,		/* name */
	dataitem_maxentut,		/* entry UTMP */
	dataitem_maxentpw,		/* entry PASSWD */
	dataitem_maxentsp,		/* entry SHADOW */
	dataitem_maxentua,		/* entry USERATTR */
	dataitem_maxentgr,		/* entry GROUP */
	dataitem_maxentpj,		/* entry PROJECT */
	dataitem_maxentpr,		/* entry PROTOCOL */
	dataitem_maxentnw,		/* entry NETWORK */
	dataitem_maxentho,		/* entry HOST */
	dataitem_maxentsv,		/* entry SERIVE */
	dataitem_maxmsg,
	dataitem_maxfstype,
	dataitem_maxtzname,
	dataitem_clk,
	dataitem_overlast
    } ; /* end enum (dataitems) */
} /* end export */

export {
    struct getter {
	con int		*name ;
	con uchar	*stab ;
	int 		ne ;
	getter(cint *na,cuchar *st,int ªn) noex {
	    name	= na ;
	    stab	= st ;
	    ne		= ªn ;
	} ; /* end ctor */
	int operator () (int sc) const noex {
	    int		rs = SR_NOTFOUND ;
	    int		rv = 0 ; /* return-value */
	    cauto predf = [this,sc] (uchar c) noex -> bool {
		cint ni = int(c) ;
		return (name[ni] < sc) ;
	    } ; /* end lambda (predf) */
	    con uchar *itf = (stab + 0) ;
	    con uchar *itl = (stab + ne) ;
	    if (cauto it = partition_point(itf,itl,predf) ; it != itl) {
		if (cint ni = int(*it) ; name[ni] == sc) {
		    rs = SR_OK ;
	    	    rv = ni ;
		} /* end if (got a match) */
	    } /* end if (partition) */
	    return (rs >= 0) ? rv : rs ;
	} ; /* end method (operator) */
    } ; /* end struct (getter) */
} /* end export */

export {
    extern const getter	getci ;
} /* end export */


