*/

/* Copyright © 1998,2020 David A­D­ Morano.  All rights reserved. */

/*******************************************************************************

  	Module:
	digtab

	Names:
	getdig
    	digtab_enc

	Description:
	Given a value we return a character digit corresponding to
	that value as deterined by the DIGTAB look-up table.  There
	is no error chæcking on the value given.  The given value
	should be between zero (0) and sizty-three (63) inclusive.
	This function facilitates the use of number bases up to
	base-64.  The function has two names that do the same thing
	(for some now-unknown historical reason).

	Synopsis:
	char getdig(int v) noex 
    	char digtab_enc(int v) noex

	Argument:
	v		value that we want the corresponding digit for

	Returns:
	-		the value of the digit requested

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU |MAXBASE| */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

export module digtab ;

/* local defines */


/* imported namespaces */


/* local typedefs */


/* external subroutines */


/* external variables */


/* local structures */

constexpr int		div100 = 100 ;

struct digtaber {
    static constexpr int	maxbase = MAXBASE ;
    uchar	dig[maxbase] ;
    char	dig100[div100][2] ;
    consteval void mkdig() noex {
    	int	i = 0 ;
	for (int j = 0 ; j < 10 ; j += 1) {
	    dig[i++] = uchar('0' + j) ;
	} /* end */
	for (int j = 0 ; j < 26 ; j += 1) {
	    dig[i++] = uchar('A' + j) ;
	} /* end */
	for (int j = 0 ; j < 26 ; j += 1) {
	    dig[i++] = uchar('a' + j) ;
	} /* end */
	dig[i++] = uchar('Ø') ;
	dig[i++] = uchar('ø') ;
    } ; /* end method (mkdig) */
    consteval void mkdig100() noex {
	for (int i = 0 ; i < div100 ; i += 1) {
	    dig100[i][0] = char((i % 10) + '0') ;
	    dig100[i][1] = char((i / 10) + '0') ;
	} /* end for */
    } ; /* end method (mkdig100) */
    consteval digtaber() noex {
	mkdig() ;
	mkdig100() ;
    } ; /* end ctor */
    constexpr char operator [] (cint) const noex ;
} ; /* end struct (digtaber) */


/* forward references */


/* local variables */


/* exported variables */

export {
    extern const digtaber	digtab ;
} /* end extern */

constexpr digtaber	digtab ;


/* exported subroutines */

export {
    constexpr char digtab_enc(int v) noex {
	cint idx = (v % digtab.maxbase) ;
	return char(digtab.dig[idx]) ;
    } /* end subroutine (digtab_get) */
    constexpr char digtaber::operator [] (cint v) const noex {
	cint idx = (v % maxbase) ;
	return char(dig[idx]) ;
    } /* end method (digtaber::operator) */
} /* end export */

export {
    extern "C" {
        char getdig(int v) noex {
	    cint idx = (v % digtab.maxbase) ;
	    return char(digtab.dig[idx]) ;
        } /* end subroutine (getdig) */
    } /* end extern (C) */
} /* end export */


