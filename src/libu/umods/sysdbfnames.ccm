/*******************************************************************************

  	Name:
	sysdbfnames

	Description:
	This module contains a structure (UNIXFNAMES) that facilitates
	retrieving various UNIX® database file names.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

export module sysdbfnames ;

export {
    struct sysdbfnames {
	static cchar	passwd[] ;
	static cchar	shadow[] ;
	static cchar	userattr[] ;
	static cchar	group[] ;
	static cchar	project[] ;
	static cchar	shells[] ;
	static cchar	protocols[] ;
	static cchar	networks[] ;
	static cchar	netmasks[] ;
	static cchar	hosts[] ;
	static cchar	services[] ;
    } ; /* end struct (sysdbfnames) */
} /* end export */

export {
    extern const sysdbfnames	sysdbfname ;
} /* end export */


