    }
} /* end export */

export {
    constexpr inline int fbscount	(uint uv) noex {
	return popcount(uv) ;
    }
    constexpr inline int fbscount	(ulong uv) noex {
	return popcount(uv) ;
    }
    constexpr inline int fbscount	(ulonglong uv) noex {
	return popcount(uv) ;
    }
} /* end export */

export {
    constexpr inline int ffbs		(int v) noex {
    	cuint uv = uint(v) ;
	return ffbsx(uv) ;
    }
    constexpr inline int ffbs		(long v) noex {
    	culong uv = ulong(v) ;
	return ffbsx(uv) ;
    }
    constexpr inline int ffbs		(longlong v) noex {
    	culonglong uv = ulonglong(v) ;
	return ffbsx(uv) ;
    }
} /* end export */

export {
    constexpr inline int ffbc		(int v) noex {
    	cuint uv = uint(v) ;
	return ffbcx(uv) ;
    }
    constexpr inline int ffbc		(long v) noex {
    	culong uv = ulong(v) ;
	return ffbcx(uv) ;
    }
    constexpr inline int ffbc		(longlong v) noex {
    	culonglong uv = ulonglong(v) ;
	return ffbcx(uv) ;
    }
} /* end export */

export {
    constexpr inline int flbs		(int v) noex {
    	cuint uv = uint(v) ;
	return flbsx(uv) ;
    }
    constexpr inline int flbs		(long v) noex {
    	culong uv = ulong(v) ;
	return flbsx(uv) ;
    }
    constexpr inline int flbs		(longlong v) noex {
