    constexpr inline int flbc		(long v) noex {
    	culong uv = ulong(v) ;
	return flbcx(uv) ;
    }
    constexpr inline int flbc		(longlong v) noex {
    	culonglong uv = ulonglong(v) ;
	return flbcx(uv) ;
