} /* end export */

export {
    constexpr inline int fbscount	(int v) noex {
    	cuint uv = uint(v) ;
	return popcount(uv) ;
    }
    constexpr inline int fbscount	(long v) noex {
    	culong uv = ulong(v) ;
	return popcount(uv) ;
    }
    constexpr inline int fbscount	(longlong v) noex {
