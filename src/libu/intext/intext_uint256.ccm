/*******************************************************************************

	Object:
	intext_uint256

	Description:
	We manage (a little bit) the UINTX object.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* CSTD */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cstdio>		/* CSTD */
#include	<concepts>		/* C++STD */
#include	<compare>		/* C++STD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<stdintx.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */
#include	<dprint.hh>		/* LIBU debugging */

export module intext.uint256 ;

import varithmetic ;
import loadvals ;
import intext.util ;
import intext.uintx ;

/* local defines */

#ifndef	CF_DEBUG
#define	CF_DEBUG	1		/* debugging */
#endif


/* imported namespaces */


/* local typedefs */

using ord = std::ordering_strong ;	/* type */


/* local constants */

constexpr bool		f_debug		= CF_DEBUG ;


/* exported stuff */

constexpr int	uint256_nbits = 256 ;

export {
    struct uint256_t : uintx<uint256_nbits> {
	static inline cint	n = ndig<uint256_nbits,uintx::digtype> ;
	uint256_t() = default ;
	uint256_t(int a)	noex : uintx(a) { } ;
	uint256_t(long a)	noex : uintx(a) { } ;
	uint256_t(longlong a)	noex : uintx(a) { } ;
	uint256_t(uint a)	noex : uintx(a) { } ;
	uint256_t(ulong a)	noex : uintx(a) { } ;
	uint256_t(ulonglong a)	noex : uintx(a) { } ;
	uint256_t(const uint256_t &a) noex : uintx<uint256_nbits>(0) {
	    vcopy(n,v,a.v) ;
	} ; /* ctor (direct initialization) */
	uint256_t &operator = (const uint256_t &a) noex {
	    vcopy(n,v,a.v) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint256_t &operator = (const uintx<uint256_nbits> &a) noex {
	    vcopy(n,v,a.v) ;
	    return *this ;
	} ;
	uint256_t &operator = (int a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint256_t &operator = (long a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint256_t &operator = (longlong a)	noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint256_t &operator = (uint a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint256_t &operator = (ulong a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint256_t &operator = (ulonglong a)	noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
    } ; /* end struct (uint256_t) */
} /* end export */


