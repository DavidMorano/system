/*******************************************************************************

	Object:
	intext_int256

	Description:
	We manage (a little bit) the UINTX object.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>
#include	<cstddef>
#include	<cstdlib>
#include	<cstdio>
#include	<concepts>
#include	<compare>
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<stdintx.h>
#include	<localmisc.h>
#include	<dprint.hh>		/* debugging */

export module intext.int256 ;

import varithmetic ;
import loadvals ;
import intext.util ;
import intext.uintx ;
import intext.uint256 ;

/* local defines */

#ifndef	CF_DEBUG
#define	CF_DEBUG	1		/* debugging */
#endif


/* imported namespaces */


/* local typedefs */

using ord = std::ordering_strong ;	/* type */


/* local constants */

constexpr bool		f_debug		= CF_DEBUG ;


/* exported stuff */

constexpr int	int256_nbits = 256 ;

export {
    struct int256_t : uintx<int256_nbits> {
	inline static cint	n = ndig<int256_nbits,uintx::digtype> ;
	int256_t() = default ;
	int256_t(int a)	noex : uintx(a) { } ;
	int256_t(long a)	noex : uintx(a) { } ;
	int256_t(longlong a)	noex : uintx(a) { } ;
	int256_t(uint a)	noex : uintx(a) { } ;
	int256_t(ulong a)	noex : uintx(a) { } ;
	int256_t(ulonglong a)	noex : uintx(a) { } ;
	int256_t(const int256_t &a) noex {
	    vcopy(n,v,a.v) ;
	} ; /* ctor (direct initialization) */
	int256_t &operator = (const int256_t &a) noex {
	    vcopy(n,v,a.v) ;
	    return *this ;
	} ; /* end method (assignment) */
	int256_t &operator = (const uintx<int256_nbits> &a) noex {
	    vcopy(n,v,a.v) ;
	    return *this ;
	} ;
	int256_t &operator = (int a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	int256_t &operator = (long a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	int256_t &operator = (longlong a)	noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	int256_t &operator = (uint a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	int256_t &operator = (ulong a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	int256_t &operator = (ulonglong a)	noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
    } ; /* end struct (int256_t) */
} /* end export */


