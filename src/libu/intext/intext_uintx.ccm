/*******************************************************************************

	Object:
	intext_uintx

	Description:
	We manage (a little bit) the UINTX object.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* CSTD */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cstdio>		/* CSTD */
#include	<concepts>		/* C++STD */
#include	<compare>		/* C++STD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<stdintx.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */
#include	<dprint.hh>		/* LIBU debugging */

export module intext.uintx ;

import varithmetic ;
import loadvals ;
import intext.util ;

/* local defines */

#ifndef	CF_DEBUG
#define	CF_DEBUG	1		/* debugging */
#endif


/* imported namespaces */


/* local typedefs */

using ord = std::ordering_strong ;	/* type */


/* local constants */

constexpr bool		f_debug		= CF_DEBUG ;


/* exported stuff */

export {
    template<int Nbits,typename Digit = ulonglong> struct uintx {
	typedef Digit		digtype ;
	inline static cint	n = ndig<Nbits,Digit> ;
	Digit			v[ndig<Nbits,Digit>] ;
	uintx() = default ;
	uintx(const uintx &o) noex {
	    vcopy(n,v,o.v) ;
	} ;
	uintx &operator = (const uintx &o) noex {
	    vcopy(n,v,o.v) ;
	    return *this ;
	} ;
	uintx(int)		noex ;
	uintx(long)		noex ;
	uintx(longlong)		noex ;
        uintx(uint)		noex ;
	uintx(ulong)		noex ;
	uintx(ulonglong)	noex ;
	void load(int)		noex ;
	void load(long)		noex ;
	void load(longlong)	noex ;
        void load(uint)		noex ;
	void load(ulong)	noex ;
	void load(ulonglong)	noex ;
	uintx operator compl () noex {
	    for (int i = 0 ; i < n ; i += 1) {
		v[i] = (compl v[i]) ;
	    }
	    return *this ;
	} ; /* end ctor */
	uintx operator - () noex {
	    Digit vt[n] ;
	    vneg(n,vt,v) ;
	    vcopy(n,v,vt) ;
	    return *this ;
	} ; /* end ctor */
	uintx &operator +=	(const uintx &o) noex {
	    Digit	r[n] ;
	    vaddu(n,r,v,o.v) ;
	    vcopy(n,v,r) ;
	    return *this ;
	} /* end method (timeval::operator) */
	uintx &operator -=	(const uintx &o) noex {
	    Digit	r[n] ;
	    vsubu(n,r,v,o.v) ;
	    vcopy(n,v,r) ;
	    return *this ;
        } /* end method (timeval::operator) */
	uintx &operator *=	(int m) noex {
	    Digit	s(m) ;
	    Digit	r[n] ;
	    vmulutrunc(n,r,v,s.v) ;
	    vcopy(n,v,r) ;
	    return *this ;
	} /* end method (timeval::operator) */
	uintx &operator *=	(const uintx &o) noex {
	    Digit	r[n] ;
	    vmulutrunc(n,r,v,o.v) ;
	    vcopy(n,v,r) ;
	    return *this ;
	} ;
	uintx &operator /=	(const uintx &o) noex {
	    Digit	q[n] ;
	    Digit	r[n] ;
	    vdivutrunc(n,q,r,v,o.v) ;
	    vcopy(n,v,q) ;
	    return *this ;
	} ;
	uintx &operator %=	(const uintx &o) noex {
	    Digit	q[n] ;
	    Digit	r[n] ;
	    vdivutrunc(n,q,r,v,o.v) ;
	    vcopy(n,v,r) ;
	    return *this ;
	} ;
	uintx &operator and_eq	(const uintx &o) noex {
	    veq_and(n,v,o.v) ;
	    return *this ;
        } /* end method (timeval::operator) */
	uintx &operator or_eq	(const uintx &o) noex {
	    veq_or(n,v,o.v) ;
        } /* end method (timeval::operator) */
	uintx &operator xor_eq	(const uintx &o) noex {
	    veq_xor(n,v,o.v) ;
	    return *this ;
        } /* end method (timeval::operator) */
	uintx &operator >>= (int nb) noex {
	    Digit	r[n] ;
	    vlshr(n,r,v,nb) ;
	    vcopy(n,v,r) ;
	    return *this ;
	} ;
	uintx &operator <<= (int nb) noex {
	    Digit	r[n] ;
	    vlshl(n,r,v,nb) ;
	    vcopy(n,v,r) ;
	    return *this ;
	} ;
	ord operator <=> (const uintx &o) const noex {
    	    ord res = ord::equal ;
	    cint rc = vcmp(n,v,o.v) ;
	    if (rc) {
	        res = (rc > 0) ? ord::greater : ord::less ;
	    }
	    return res ;
	} /* end smethod (uintx) */
	void clear() noex {
	    vclear(n,v) ;
	} ;
	uintx add	(const uintx &o) const noex {
	    uintx res ;
	    vaddu(n,res.v,v,o.v) ;
	    return res ;
	} ;
	uintx sub	(const uintx &o) const noex {
	    uintx res ;
	    vsubu(n,res.v,v,o.v) ;
	    return res ;
	} ;
	uintx mul	(const uintx &o) const noex {
	    uintx res ;
	    vmulutrunc(n,res.v,v,o.v) ;
	    return res ;
	} ;
	uintx div	(const uintx &o) const noex {
	    Digit	r[n] ;
	    uintx res ;
	    vdivutrunc(n,res.v,r,v,o.v) ;
	    return res ;
	} ;
	uintx rem	(const uintx &o) const noex {
	    Digit	q[n] ;
	    uintx res ;
	    vdivutrunc(n,q,res.v,v,o.v) ;
	    return res ;
	} ;
	uintx band	(const uintx &o) const noex {
	    uintx res ;
	    vand(n,res.v,v,o.v) ;
	    return res ;
	} ;
	uintx bor	(const uintx &o) const noex {
	    uintx res ;
	    vor(n,res.v,v,o.v) ;
	    return res ;
	} ;
	uintx bxor	(const uintx &o) const noex {
	    uintx res ;
	    vxor(n,res.v,v,o.v) ;
	    return res ;
	} ;
	uintx rotr(int nb) const noex {
	    uintx res ;
	    vrotr(n,res.v,v,nb) ;
	    return res ;
	} ;
	uintx rotl(int nb) const noex {
	    uintx res ;
	    vrotl(n,res.v,v,nb) ;
	    return res ;
	} ;
	uintx rotx(int nb) const noex {
	    uintx res ;
	    if (nb >= 0) {
		res = rotr(nb) ;
	    } else {
		res = rotl(nb) ;
	    }
	    return res ;
	} ;
	uintx lshr(int nb) const noex {
	    uintx res ;
	    vlshr(n,res.v,v,nb) ;
	    return res ;
	} ; /* end method (lshr) */
	uintx lshl(int nb) const noex {
	    uintx res ;
	    vlshl(n,res.v,v,nb) ;
	    return res ;
	} ; /* end method (lshl) */
	uintx lshx(int nb) const noex {
	    uintx res ;
	    if (nb >= 0) {
		res = lshr(nb) ;
	    } else {
		res = lshl(nb) ;
	    }
	    return res ;
	} ; /* end method (lshx) */
	uintx ashr(int nb) const noex {
	    uintx res ;
	    vashr(n,res.v,v,nb) ;
	    return res ;
	} ; /* end method (ashr) */
	uintx ashl(int nb) const noex {
	    uintx res ;
	    vashl(n,res.v,v,nb) ;
	    return res ;
	} ; /* end method (ashl) */
	uintx ashx(int nb) const noex {
	    uintx res ;
	    if (nb >= 0) {
		res = ashr(nb) ;
	    } else {
		res = ashl(nb) ;
	    }
	    return res ;
	} ; /* end method (ashx) */
	uintx operator +	(const uintx &o) const noex {
	    return add(o) ;
	} ;
	uintx operator -	(const uintx &o) const noex {
	    return sub(o) ;
	} ;
	uintx operator *	(const uintx &o) const noex {
	    return mul(o) ;
	} ;
	uintx operator /	(const uintx &o) const noex {
	    return div(o) ;
	} ;
	uintx operator %	(const uintx &o) const noex {
	    return rem(o) ;
	} ;
	uintx operator bitand	(const uintx &o) const noex {
	    return band(o) ;
	} ;
	uintx operator bitor	(const uintx &o) const noex {
	    return bor(o) ;
	} ;
	uintx operator bitxor	(const uintx &o) const noex {
	    return bxor(o) ;
	} ;
	uintx operator >>	(const uintx &o) const noex {
	    return lshr(o) ;
	} ;
	uintx operator <<	(const uintx &o) const noex {
	    return lshl(o) ;
	} ;
	operator bool		() const noex {
	    return visgot(n,v) ;
	} ;
	operator uint		() const noex {
	    return uintconv(v[0]) ;
	} ;
	operator ulong 		() const noex {
	    return ulongconv(v[0]) ;
	} ;
	operator ulonglong 	() const noex {
	    return v[0] ;
	} ;
	operator int		() const noex {
	    return intconv(v[0]) ;
	} ;
	operator long		() const noex {
	    return longconv(v[0]) ;
	} ;
	operator longlong	() const noex {
	    return longlongconv(v[0]) ;
	} ;
    } ; /* end struct-template (uintx) */
} /* end export */

export {
    template<int Nbits,typename Digit>
	void uintx<Nbits,Digit>::load(uint a)		noex {
	    vclear(n,v) ;
            v[0] = a ;
	} ;
    template<int Nbits,typename Digit>
	void uintx<Nbits,Digit>::load(ulong a)		noex {
	    vclear(n,v) ;
            v[0] = a ;
	} ;
    template<int Nbits,typename Digit>
	void uintx<Nbits,Digit>::load(ulonglong a)	noex {
	    vclear(n,v) ;
            v[0] = a ;
	} ;
} /* end export */

export {
    template<int Nbits,typename Digit>
	void uintx<Nbits,Digit>::load(int a)		noexcept {
	    loadval(n,v,a) ;
        } ; /* end ctor */
    template<int Nbits,typename Digit>
	void uintx<Nbits,Digit>::load(long a)		noexcept {
	    loadval(n,v,a) ;
        } ; /* end ctor */
    template<int Nbits,typename Digit>
	void uintx<Nbits,Digit>::load(longlong a)	noexcept {
	    loadval(n,v,a) ;
        } ; /* end ctor */
} /* end export */

export {
    template<int Nbits,typename Digit>
	uintx<Nbits,Digit>::uintx(int a)	noexcept {
	    load(a) ;
	} ;
    template<int Nbits,typename Digit>
	uintx<Nbits,Digit>::uintx(long a)	noexcept {
	    load(a) ;
	} ;
    template<int Nbits,typename Digit>
	uintx<Nbits,Digit>::uintx(longlong a)	noexcept {
	    load(a) ;
	} ;
} /* end export */

export {
    template<int Nbits,typename Digit>
        uintx<Nbits,Digit>::uintx(uint a)	noexcept {
	    load(a) ;
        } ; /* end ctor */
    template<int Nbits,typename Digit>
        uintx<Nbits,Digit>::uintx(ulong a)	noexcept {
	    load(a) ;
        } ; /* end ctor */
    template<int Nbits,typename Digit>
        uintx<Nbits,Digit>::uintx(ulonglong a)	noexcept {
	    load(a) ;
        } ; /* end ctor */
} /* end export */


