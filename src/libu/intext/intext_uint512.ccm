/*******************************************************************************

	Object:
	intext_uint512

	Description:
	We manage (a little bit) the UINTX object.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* CSTD */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cstdio>		/* CSTD */
#include	<concepts>		/* C++STD */
#include	<compare>		/* C++STD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<stdintx.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */
#include	<dprint.hh>		/* debugging */

export module intext.uint512 ;

import varithmetic ;
import loadvals ;
import intext.util ;
import intext.uintx ;
import intext.uint256 ;

/* local defines */

#ifndef	CF_DEBUG
#define	CF_DEBUG	1		/* debugging */
#endif


/* imported namespaces */


/* local typedefs */

using ord = std::ordering_strong ;	/* type */


/* local constants */

constexpr bool		f_debug		= CF_DEBUG ;


constexpr int	uint512_nbits = 512 ;

export {
    struct uint512_t : uintx<uint512_nbits> {
	inline static cint	n = ndig<uint512_nbits,uintx::digtype> ;
	uint512_t() = default ;
	uint512_t(int a)	noex : uintx(a) { } ;
	uint512_t(long a)	noex : uintx(a) { } ;
	uint512_t(longlong a)	noex : uintx(a) { } ;
	uint512_t(uint a)	noex : uintx(a) { } ;
	uint512_t(ulong a)	noex : uintx(a) { } ;
	uint512_t(ulonglong a)	noex : uintx(a) { } ;
	uint512_t(const uint256_t &a) noex : uintx<uint512_nbits>(0) {
	    cint nh = (n / 2) ;
	    vcopy(nh,v,a.v) ;
	    vclear(nh,(v + nh)) ;
	} ; /* ctor (direct initialization) */
	uint512_t(const uint512_t &a) noex : uintx<uint512_nbits>(0) {
	    vcopy(n,v,a.v) ;
	} ; /* ctor (direct initialization) */
	uint512_t &operator = (const uintx<256> &a) noex {
	    cint nh = (n / 2) ;
	    vcopy(nh,v,a.v) ;
	    vclear(nh,(v + nh)) ;
	    return *this ;
	} ;
	uint512_t &operator = (const uintx<512> &a) noex {
	    vcopy(n,v,a.v) ;
	    return *this ;
	} ;
	uint512_t &operator = (int a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint512_t &operator = (long a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint512_t &operator = (longlong a)	noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint512_t &operator = (uint a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint512_t &operator = (ulong a)		noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint512_t &operator = (ulonglong a)	noex {
	    load(a) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint512_t &operator = (const uint256_t &a) noex {
	    cint nh = (n / 2) ;
	    vcopy(nh,v,a.v) ;
	    vclear(nh,(v + nh)) ;
	    return *this ;
	} ; /* end method (assignment) */
	uint512_t &operator = (const uint512_t &a) noex {
	    vcopy(n,v,a.v) ;
	    return *this ;
	} ; /* end method (assignment) */
    } ; /* end struct (uint512_t) */
} /* end export */


