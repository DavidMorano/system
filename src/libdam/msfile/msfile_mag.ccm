/*******************************************************************************

  	Object:
	msfile

	Description:
	This subroutine maintains a MSFILE file.  This file is used
	to maintain machine status for nodes in the local machine
	cluster.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */
#include	<endian.h>		/* LIBU */
#include	<ucmem.h>		/* LIBUC */
#include	<localmisc.h>		/* LIBU */
#include	<libdebug.h>		/* LIBDEBUG |DEBUGPRINTF(3debug)| */

#include	"msfile.h"

export module msfile_mag ;


export {
    template<typename ... Args>
    inline int msfile_magic(msfile *op,Args ... args) noex {
	int		rs = SR_FAULT ;
	if (op && (args && ...)) {
	    rs = (op->magval == MSFILE_MAGIC) ? SR_OK : SR_NOTOPEN ;
	}
	return rs ;
    } /* end subroutine (msfile_magic) */
} /* end export */


