/* msfile_mag MODULE (primary) */
/* charset=ISO8859-1 */
/* lang=C++20 */

/* object to manipulate a MSFILE file */
/* version %I% last-modified %G% */

#define	CF_DEBUG	0		/* non-switchable debug print-outs */

/* revision history:

	= 1999-06-01, David A­D­ Morano
	This code was originally written.

*/

