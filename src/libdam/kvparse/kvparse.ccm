/*******************************************************************************

	Object:
	kvparse

	Description:
	This object parses a simple string into a key-value pair.
	The result of the parse is stored in the object as two
	pointer-length pairs.

	Synopsis:
	kvparse(cchar *sp,int sl) noex

	Arguments:
	sp		source array of integers
	sl		length of source array

	Returns:
	>=0		OK
	<0		error (system-return)

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */

export module kvparse ;

/* local defines */


/* external subroutines */


/* external variables */


/* forwards references */


/* local variables */


/* exported variables */


/* exported subroutines */

export {
    struct kvparse {
	cchar		*keyp ;
	cchar		*valp ;
	int		keyl ;
	int		vall ;
	void initvars() noex {
	    keyp = nullptr ;
	    valp = nullptr ;
	    keyl = 0 ;
	    vall = 0 ;
	} ; /* end method */
	kvparse() noex {
	    initvars() ;
	} ; /* end ctor */
        int extract(cchar *,int) noex ;
	destruct kvparse() {
	    initvars() ;
	} ; /* end dtor */
    } ; /* end struct (kvparse) */
} /* end export */


