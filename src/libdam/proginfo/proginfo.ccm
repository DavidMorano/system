/*******************************************************************************

	Module:
	proginfo

	Description:
	This module provides a very basic sets of simple subroutines
	for basic program management.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */
#include	<vecstr.h>		/* LIBUC */
#include	<ids.h>			/* LIBUC */
#include	<logfile.h>		/* LIBUC */

export module proginfo ;

#define	PI		proginfo
#define	PI_FL		proginfo_fl
#define	PI_VALS		proginfo_vals


enum proginfomems {
	proginfomem_ncpu,
	proginfomem_finish,
	proginfomem_progname,		/* program name */
	proginfomem_progename,		/* execution file-name */
	proginfomem_progdname,		/* dirname of arg[0] */
	proginfomem_rootdname,		/* root directory name */
	proginfomem_overlast
} ; /* end enum (proginfomems) */

export {
    struct proginfo ;
    struct proginfo_fl {
	uint		logfile:1 ;	/* LOGFILE objext initialized */
	uint		progdash:1 ;	/* leading dash on program-name */
	uint		akopts:1 ;
	uint		aparams:1 ;
	uint		quiet:1 ;
	uint		ignore:1 ;
	uint		errfile:1 ;
	uint		outfile:1 ;
	uint		pcsconf:1 ;
	uint		cfname:1 ;
	uint		lfname:1 ;
	uint		pidfname:1 ;
	uint		logprog:1 ;
	uint		config:1 ;
	uint		watch:1 ;
	uint		background:1 ;
	uint		daemon:1 ;
	uint		logsize:1 ;
	uint		nodeonly:1 ;
	uint		tmpdate:1 ;
	uint		disable:1 ;
	uint		all:1 ;
	uint		def:1 ;
	uint		lister:1 ;
	uint		bufwhole:1 ;
	uint		bufline:1 ;
	uint		bufnone:1 ;
	uint		intrun:1 ;
	uint		intidle:1 ;
	uint		intpoll:1 ;
	uint		intmark:1 ;
	uint		intlock:1 ;
	uint		intdis:1 ;
	uint		reuseaddr:1 ;
	uint		to:1 ;
    } ; /* end struct (proginfo_fl) */
    struct proginfo_start {
	using		mv = mainv ;
    	statcexpr auto	np = nullptr ;
	proginfo	*op = nullptr ;
	void operator () (proginfo *p) noex {
	    op = p ;
	} ; /* end */
	int operator () (int = -1,mv = np,mv = np,ccp = np) noex ;
	int operator () (mainv) noex ;
	operator int () noex {
	    return operator () (-1) ;
	} ; /* end */
    } ; /* end struct (proginfo_start) */
    struct proginfo_hwser {
	proginfo	*op = nullptr ;
	uint		val ;
	void operator () (proginfo *p) noex {
	    op = p ;
	    val = 0 ;
	} ; /* end */
	operator uint() noex ;
    } ; /* end struct (proginfo_hwser) */
    struct proginfo_ccharp {
	friend		proginfo ;
    	proginfo	*op ;
	int		w ;
	ccharp		valp ;
    	void operator () (proginfo *p,int m) noex {
	    op	= p ;
	    w	= m ;
	} ; /* end */
	proginfo_ccharp() noex : valp(nullptr) { } ;
	operator ccharp () noex ;
    } ; /* end struct proginfo_ccharp) */
    struct proginfo_co {
	proginfo	*op = nullptr ;
	int		w = -1 ;
	void operator () (proginfo *p,int m) noex {
	    op = p ;
	    w = m ;
	} ; /* end */
	int operator () (int = -1) noex ;
	operator int () noex {
	    return operator () () ;
	} ; /* end */
    } ; /* end struct (proginfo_co) */
    struct proginfo_eprint {
	proginfo	*op = nullptr ;
	int		w = -1 ;
	void operator () (proginfo *p,int m) noex {
	    op = p ;
	    w = m ;
	} ; /* end */
	int operator () (ccharp,int = -1) noex ;
	int operator () () noex ;
	operator int () noex {
	    return operator () (nullptr) ;
	} ; /* end */
    } ; /* end struct (proginfo_eprint) */
    struct proginfo_vals {
	ccharp		argz ;		/* raw ARGZ */
	cchar		*searchname ;
	cchar		*pr ;		/* program root */
	cchar		*rootname ;	/* distribution name */
	cchar		*version ;
	cchar		*banner ;
	cchar		*umachine ;	/* UNAME machine name */
	cchar		*usysname ;	/* UNAME OS system-name */
	cchar		*urelease ;	/* UNAME OS release */
	cchar		*uversion ;	/* UNAME OS version */
	cchar		*architecture ;	/* UAUX machine architecture */
	cchar		*platform ;	/* UAUX machine platform */
	cchar		*provider ;	/* UAUX machine provider */
	cchar		*nisdomain ;	/* UAUX machine nisdomain */
	cchar		*hz ;		/* OS HZ */
	cchar		*nodename ;	/* USERINFO */
	cchar		*domainname ;	/* USERINFO */
	cchar		*username ;	/* USERINFO */
	cchar		*homedname ;	/* USERINFO */
	cchar		*shell ;	/* USERINFO */
	cchar		*org ;		/* USERINFO */
	cchar		*gecosname ;	/* USERINFO */
	cchar		*realname ;	/* USERINFO */
	cchar		*name ;		/* USERINFO */
	cchar		*fullname ;	/* USERINFO full-name */
	cchar		*mailname ;	/* USERINFO mail-abbreviated-name */
	cchar		*tz ;		/* USERINFO */
	cchar		*maildname ;	/* USERINFO */
	cchar		*logid ;	/* USERINFO ID for logging purposes */
	cchar		*orgcode ;
	cchar		*groupname ;
	cchar		*hostname ;
	cchar		*tmpdname ;
	cchar		*random ;	/* SHELL */
	cchar		*seconds ;	/* SHELL */
	cchar		*newsdname ;
	cchar		*hfname ;
	cchar		*cfname ;
	cchar		*lfname ;
	cchar		*pidfname ;
	cchar		*zname ;	/* time-zone abbreviation */
	cchar		*pwdbuf ;	/* present-wirkubg-directory */
	void		*efp ;
	void		*buffer ;	/* general buffer */
	void		*contextp ;	/* SHELL context */
	void		*lip ;		/* local information */
	void		*uip ;		/* USERINFO object */
	void		*userlist ;	/* user-list state */
	void		*config ;	/* configuration */
	void		*watch ;	/* watch */
	void		*pcsconf ;	/* save space when not needed */
	int		debuglevel ;
	int		verboselevel ;
	int		quietlevel ;
	int		to ;		/* general time-out */
	int		to_open ;	/* open time-out */
	int		to_read ;	/* read time-out */
	int		logsize ;	/* max log-file size */
	int		intrun ;	/* interval run */
	int		intidle ;	/* interval idle */
	int		intpoll ;	/* interval poll */
	int		intmark ;	/* interval mark */
	int		intlock ;	/* interval lock */
	int		intdis ;	/* interval disable */
	int		pserial ;	/* "pserial" serial number */
	int		serial ;	/* serial number */
	int		ncpus ;		/* internal storage */
	int		pwdlen ;
	proginfo_vals() noex ;
    } ; /* end struct (proginfo_vals) */
    struct proginfo : proginfo_vals {
	friend		proginfo_start ;
	friend		proginfo_hwser ;
	friend		proginfo_ccharp ;
	friend		proginfo_co ;
	friend		proginfo_eprint ;
    	statcexpr auto	np = nullptr ;
	proginfo_hwser	hwserial ;
	proginfo_start	start ;
	proginfo_co	ncpu ;
	proginfo_co	finish ;
	proginfo_eprint	eprint ;
	proginfo_ccharp	progname ;	/* program name */
	proginfo_ccharp	progename ;	/* execution file-name */
	proginfo_ccharp	progdname ;	/* dirname of arg[0] */
	proginfo_ccharp	rootdname ;
	vecstr		*sdp ;		/* store-data-pointer */
	ids		*idp ;
	logfile		*lfp ;
	mainv		argv ;
	mainv		envv ;
	ulong		randvar ;
	TIMEB		now ;
	time_t		daytime ;
	pid_t		pid ;
	uid_t		uid, euid ;
	gid_t		gid, egid ;
	PI_FL		pfhave{} ;
	PI_FL		pf{} ;
	PI_FL		pfchanged{} ;
	PI_FL		pfopen{} ;
	int		prs ;		/* previous-return-status */
	int		argc ;
	int		pm ;		/* program-mode */
	proginfo	(int,con mainv,con mainv) noex ;
	proginfo	() noex : proginfo(0,np,np) { } ;
	void args	(int,con mainv,con mainv) noex ;
	int progmode	(mainv) noex ;
	int setent	(cchar **,cchar *,int = -1) noex ;
	int setversion	(cchar *) noex ;
	int setbanner	(cchar *) noex ;
	int setsearch	(cchar *,cchar *) noex ;
	int setprogroot	(cchar *,int) noex ;
	int getpwd	(char *,int) noex ;
	int getpname	(char *,int) noex ;
	int getename	(char *,int) noex ;
	int expand	(char *,int,cchar *,int) noex ;
	int eprintf	(cchar *,...) noex ;
   private:
	int pstart	(int,mainv,mainv,ccharp) noex ;
	int pfinish	() noex ;
	int pncpu	() noex ;
    } ; /* end struct (proginfo) */
} /* end export */

int proginfo_pwd	(PI *) noex ;
int proginfo_progpname	(PI *) noex ;
int proginfo_progename	(PI *) noex ;
int proginfo_progdname	(PI *) noex ;
int proginfo_rootdname	(PI *) noex ;
int proginfo_nodename	(PI *) noex ;

export {
	int proginfo_getpname	(PI *,char *,int) noex ;
	int proginfo_getename	(PI *,char *,int) noex ;
	int proginfo_getdname	(PI *,char *,int) noex ;
        int proginfo_getpwd	(PI *,char *,int) noex ;
	int proginfo_getenv	(PI *,cchar *,int,ccharpp) noex ;
        int proginfo_realbegin	(PI *) noex ;
        int proginfo_realend	(PI *) noex ;
} /* end export */


