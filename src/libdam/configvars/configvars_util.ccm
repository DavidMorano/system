module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */
#include	<vecobj.h>		/* LIBU */

#include	"configvars.h"

export module configvars_util ;

export {
    enum configvarsws {
	configvarsw_sets,
	configvarsw_vars,
	configvarsw_unsets,
	configvarsw_unvars,
	configvarsw_overlast
    } ; /* end enum */
} /* end export */

export {
    enum keytypes {
	keytype_define,
	keytype_export,
	keytype_set,
	keytype_unset,
	keytype_var,
	keytype_overlast
    } ; /* end enum */
} /* end export */

export {
    template<typename ... Args>
    inline int configvars_magic(configvars *op,Args ... args) noex {
	int		rs = SR_FAULT ;
	if (op && (args && ...)) {
	    rs = (op->magval == CONFIGVARS_MAGIC) ? SR_OK : SR_NOTOPEN ;
	}
	return rs ;
    } /* end subroutine (configvars_magic) */
} /* end export */


