/* modproc MODULE (primary-module-interface) */
/* charset=ISO8859-1 */
/* lang=C++20 */

/* Module-Processing - C++ module name processing (from C++ source files) */
/* version %I% last-modified %G% */

#define	CF_DEBUG	0		/* debugging */

/* revision history:

	= 1998-04-10, David A­D­ Morano
	This subroutine was written for Rightcore Network Services.

*/

/* Copyright © 1998 David A­D­ Morano.  All rights reserved. */

/*******************************************************************************

	module:
	modproc

	Description:
	I parse a C++ source code file and find all of the module
	names that I can that are being imported to that source file.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<cstdio>		/* |FILE| */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<usysrets.h>

#pragma		GCC dependency		"mod/ureserve.ccm"
#pragma		GCC dependency		"mod/debug.ccm"

export module modproc ;

import ureserve ;			/* |vecstr(3u)| */
import debug ;

/* local defines */

#ifndef	CF_DEBUG
#define	CF_DEBUG	0		/* debugging */
#endif

cbool			f_debug = CF_DEBUG ;

export {
    extern int	modprocload(vecstr *,cchar *) noex ;
}

export {
    enum modouts {
    	modout_name,
    	modout_mod,
    	modout_gcm,
    	modout_obj,
    	modout_modobj,
    	modout_overlast
    } ; /* end enum (modouts) */
    constexpr cpcchar	modoutnames[] = {
    	[modout_name]		= "name",
    	[modout_mod]		= "mod",
    	[modout_gcm]		= "gcm",
    	[modout_obj]		= "obj",
    	[modout_modobj]		= "modobj",
    	[modout_overlast]	= nullptr
    } ; /* end array (modoutnames) */
} /* end export) */

enum modprocmems {
    	modprocmem_start,
    	modprocmem_finish,
    	modprocmem_ovelast
} ; /* end enum (modprocmems) */

export {
    struct modproc ;
    struct modproc_co {
	modproc		*op = nullptr ;
	int		w = -1 ;
	constexpr void operator () (modproc *p,int m) noex {
	    op = p ;
	    w = m ;
	} ;
	operator int () noex ;
	int operator () () noex {
	    return operator int () ;
	} ;
    } ; /* end struct (modproc_co) */
    struct modproc {
	friend		modproc_co ;
	modproc_co	start ;
	modproc_co	finish ;
	void		*vop{} ;
	modproc() noex {
	    start	(this,modprocmem_start) ;
	    finish	(this,modprocmem_finish) ;
	} ;
        int	procfile(cchar *) noex ;
	int	procout(FILE *,int) noex ;
	void dtor() noex ;
	destruct modproc() {
	    if (vop) dtor() ;
	} ;
    private:
	int istart() noex ;
	int ifinish() noex ;
    } ; /* end struct (modproc) */
} /* end export */


