module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* |unllptr_t| */
#include	<cstdlib>
#include	<cmath>			/* C-lang math */
#include	<complex>		/* STL complex numbers */
#include	<numbers>		/* constant 'pi' */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<localmisc.h>

export module fft ;

/* local defines */


/* imported namespaces */

using namespace std::numbers ;

using std::complex ;			/* type */


//   FFT template, double by default 
export {
    template <class T = double> class TFFT {
    public:
	//   FORWARD FOURIER TRANSFORM
	//     Input  - input data
	//     Output - transform result
	//     N      - length of both input data and result
	static bool Forward(const complex<T> *const Input, 
		complex<T> *const Output, const uint N);

	//   FORWARD FOURIER TRANSFORM, INPLACE VERSION
	//     Data - both input data and output
	//     N    - length of input data
	static bool Forward(complex<T> *const Data, const uint N);

	//   INVERSE FOURIER TRANSFORM
	//     Input  - input data
	//     Output - transform result
	//     N      - length of both input data and result
	//     Scale  - if to scale result
	static bool Inverse(const complex<T> *const Input, 
		complex<T> *const Output, const uint N, 
		const bool Scale = true);

	//   INVERSE FOURIER TRANSFORM, INPLACE VERSION
	//     Data  - both input data and output
	//     N     - length of both input data and result
	//     Scale - if to scale result
	static bool Inverse(complex<T> *const Data, const uint N, 
		const bool Scale = true);

    protected:
	//   Rearrange function and its inplace version
	static void Rearrange(const complex<T> *const Input, 
		complex<T> *const Output, const uint N);
	static void Rearrange(complex<T> *const Data, const uint N);

	//   FFT implementation
	static void Perform(complex<T> *const Data, const uint N, 
		const bool Inverse = false);

	//   Scaling of inverse FFT result
	static void Scale(complex<T> *const Data, const uint N);
    } ; /* end struct (TFFT) */
} /* end export */

//   fft.cpp - impelementation of STL template
//   of fast Fourier transform - FFT
//
//   The code is property of LIBROW
//   You can use it on your own
//   When utilizing credit LIBROW site


//   FORWARD FOURIER TRANSFORM
//     Input  - input data
//     Output - transform result
//     N      - length of both input data and result
export {
    template <class T> 
    bool TFFT<T>::Forward(const complex<T> *const Input, 
		complex<T> *const Output, const uint N) {
	//   Check input parameters
	if (!Input || !Output || N < 1 || N & (N - 1))
		return false;
	//   Initialize data
	Rearrange(Input, Output, N);
	//   Call FFT implementation
	Perform(Output, N);
	//   Succeeded
	return true;
   }

//   FORWARD FOURIER TRANSFORM, INPLACE VERSION
//     Data - both input data and output
//     N    - length of input data
    template <class T> 
    bool TFFT<T>::Forward(complex<T> *const Data, const uint N) {
	//   Check input parameters
	if (!Data || N < 1 || N & (N - 1))
		return false;
	//   Rearrange
	Rearrange(Data, N);
	//   Call FFT implementation
	Perform(Data, N);
	//   Succeeded
	return true;
    } /* end subroutine-template */

//   INVERSE FOURIER TRANSFORM
//     Input  - input data
//     Output - transform result
//     N      - length of both input data and result
//     Scale  - if to scale result
    template <class T> 
    bool TFFT<T>::Inverse(const complex<T> *const Input, 
	    complex<T> *const Output, const uint N, 
	    const bool Scale /* = true */) {
	//   Check input parameters
	if (!Input || !Output || N < 1 || N & (N - 1))
		return false;
	//   Initialize data
	Rearrange(Input, Output, N);
	//   Call FFT implementation
	Perform(Output, N, true);
	//   Scale if necessary
	if (Scale) {
		TFFT<T>::Scale(Output, N);
	}
	//   Succeeded
	return true;
    } /* end subroutine-template */

//   INVERSE FOURIER TRANSFORM, INPLACE VERSION
//     Data  - both input data and output
//     N     - length of both input data and result
//     Scale - if to scale result
   template <class T> 
   bool TFFT<T>::Inverse(complex<T> *const Data, const uint N, 
	   const bool Scale /* = true */) {
	//   Check input parameters
	if (!Data || N < 1 || N & (N - 1))
		return false;
	//   Rearrange
	Rearrange(Data, N);
	//   Call FFT implementation
	Perform(Data, N, true);
	//   Scale if necessary
	if (Scale) {
		TFFT<T>::Scale(Data, N);
	}
	//   Succeeded
	return true;
    } /* end subroutine-template */

//   Rearrange function
    template <class T> 
    void TFFT<T>::Rearrange(const complex<T> *const Input, 
	complex<T> *const Output, const uint N) {
	//   Data entry position
	uint Target = 0;
	//   Process all positions of input signal
	for (uint Position = 0; Position < N; ++Position) {
		//  Set data entry
		Output[Target] = Input[Position];
		//   Bit mask
		uint Mask = N;
		//   While bit is set
		while (Target & (Mask >>= 1))
			//   Drop bit
			Target &= ~Mask;
		//   The current bit is 0 - set it
		Target |= Mask;
	} /* end for */
    } /* end subroutine-template */

//   Inplace version of rearrange function
    template <class T> 
    void TFFT<T>::Rearrange(complex<T> *const Data, const uint N) {
	//   Swap position
	uint Target = 0;
	//   Process all positions of input signal
	for (uint Position = 0; Position < N; ++Position) {
		//   Only for not yet swapped entries
		if (Target > Position) {
			//   Swap entries
			const complex<T> Temp(Data[Target]);
			Data[Target] = Data[Position];
			Data[Position] = Temp;
		}
		//   Bit mask
		uint Mask = N;
		//   While bit is set
		while (Target & (Mask >>= 1)) {
			//   Drop bit
			Target &= ~Mask;
		} /* end while */
		//   The current bit is 0 - set it
		Target |= Mask;
	} /* end for */
    } /* end subroutine-template */

//   FFT implementation
    template <class T> 
    void TFFT<T>::Perform(complex<T> *const Data, const uint N, 
	const bool Inverse /* = false */) {
	//   Pi constant
	const T pi = Inverse ? pi_v<T> : - pi_v<T> ;
	//   Iteration through dyads, quadruples, octads and so on...
	for (uint Step = 1; Step < N; Step <<= 1) {
		//   Jump to the next entry of the same transform factor
		const uint Jump = Step << 1 ;
		//   Angle increment
		const T delta = pi / T(Step) ;
		//   Auxiliary sin(delta / 2)
		const T Sine = sin(delta * T(0.5)) ;
		//   Multiplier for trigonometric recurrence
		const complex<T> Multiplier(T(-2.0) * Sine * Sine, sin(delta)) ;
		//   Start value for transform factor, fi = 0
		complex<T> Factor(T(1.0)) ;
		//   Iteration through groups of different transform factor
		for (uint Group = 0 ; Group < Step ; ++Group) {
			//   Iteration within group 
		    for (uint Pair = Group ; Pair < N ; Pair += Jump) {
				//   Match position
				const uint Match = Pair + Step;
				//   Second term of two-point transform
				const complex<T> Product(Factor * Data[Match]);
				//   Transform for fi + pi
				Data[Match] = Data[Pair] - Product;
				//   Transform for fi
				Data[Pair] += Product;
		    } /* end for */
		    // Successive transform factor via trigonometric recurrence
		    Factor = Multiplier * Factor + Factor;
		} /* end for */
	} /* end for */
    } /* end subroutine-template */

    //   Scaling of inverse FFT result
    template <class T> 
    void TFFT<T>::Scale(complex<T> *const Data, const uint N) {
	//   Scale factor
	const T Factor = T(1.0) / T(N) ;
	//   Scale all data entries
	for (uint Position = 0 ; Position < N ; ++Position) {
	    Data[Position] *= Factor ;
	} /* end for */
    } /* end subroutine-template */
} /* end export */


