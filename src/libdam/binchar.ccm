/* binchar MODULE (primary-module-interface) */
/* charset=ISO8859-1 */
/* lang=C++20 (conformance reviewed) */

/* return the charater-digit corresponding to a specified bit in an integer */
/* lang=C++20 (conformance reviewed) */


/* revision history:

	= 2020-05-02, David A­D­ Morano
	This subroutine was written for Rightcore Network Services.

*/

/* Copyright © 2020 David A­D­ Morano.  All rights reserved. */

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

export module binchar ;

import rshiftx ;

export {
    template<typename T> inline int binchar(T num,int i) noex {
	return (rshiftx(num,i) & 1) + '0' ;
    } /* end subroutine */
} /* end export */


