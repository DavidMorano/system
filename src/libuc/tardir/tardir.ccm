/*******************************************************************************

	Object:
	tardir

	Description:
	This is a container for directories.  Only a single name
	for each directory is retained (additional path-names for
	directories).  Subsequent path-names that are aliases for
	previous path-names are ignored (the first one is picked).

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<clanguage.h>
#include	<usysbase.h>

export module tardir ;

export import :prime ;
export import :vecent ;

cbool		f_debug = CF_DEBUG ;


