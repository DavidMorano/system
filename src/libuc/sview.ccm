/*******************************************************************************

  	Object:
	sview

	Description:
	This is a handly object to store both the pointer and the
	length of a c-string.  This isued to pass around a counted
	c-string without passing two parameters (the pointer and
	the lenth) but rather only one parameter (this object
	itself).

	Synopsis:
	sview	<obj>(cchar *sp,int sl) noex

	Arguments:
	sp	counted c-string pinter
	sl	counted c-string length

	Returns:
	-

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstring>		/* |strlen(3c)| */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>

#pragma		GCC dependency		"mod/libutil.ccm"

export module sview ;

import libutil ;			/* |lenstr(3u)| */

export {
    struct sview {
	cchar		*sp ;
	int		sl ;
	constexpr sview() noex : sp(nullptr), sl(0) { } ;
	constexpr sview(cchar *p,int l) noex : sp(p), sl(l) { 
	   if (l < 0) {
	       sl = lenstr(p) ;
	   }
	} ;
	constexpr sview(const sview &o) noex {
	    sp = o.sp ;
	    sl = o.sl ;
	} ;
	constexpr sview(sview &&o) noex {
	    sp = o.sp ;
	    sl = o.sl ;
	    o.sp = nullptr ;
	    o.sl = 0 ;
	} ; /* end ctor (move-constructor) */
	constexpr sview(const sview *op) noex {
	    sp = op->sp ;
	    sl = op->sl ;
	} ;
	constexpr const sview &operator = (const sview &o) noex {
	    sp = o.sp ;
	    sl = o.sl ;
	    return *this ;
	} ;
	constexpr const sview &operator = (cchar *osp) noex {
	    sp = osp  ;
	    sl = lenstr(osp) ;
	    return *this ;
	} ;
    } ; /* end struct (sview) */
} /* end export */


