export module retstat ;

export {
    class retstat {
	int		rs ;
    public:
	retstat(int a) : rs(a) { } ;
	int get() const { 
	    return rs ; 
	} ;
	void set(int a) { 
	    rs = a ; 
	} ;
	operator int () noex {
    	    return rs ;
	} ;
    } ; /* end struct (retstat) */
} /* end export */


