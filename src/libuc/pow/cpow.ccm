/*******************************************************************************

	Names:
	cpow

	Description:
	Calculate a power of a base.

	Synopsis:
	constexpr int64_t cpow(int64_t b,int e) noex

	Arguments:
	b		base
	e		exponent

	Returns:
	-		b raised to the power e

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<climits>		/* |UCHAR_MAX| */
#include	<cstddef>		/* |nullptr_t| */
#include	<cstdlib>
#include	<cstdint>		/* |int64_t| */
#include	<utility>		/* |in_range(3c++)| */
#include	<envstandards.h>	/* ordered first to configure */
#include	<clanguage.h>
#include	<utypedefs.h>
#include	<utypealiases.h>
#include	<usysdefs.h>
#include	<usysrets.h>
#include	<stdintx.h>		/* |int128_t| */
#include	<localmisc.h>

export module cpow ;

/* local defines */


/* imported namespaces */

using std::in_range ;			/* subroutine -- unused */


/* local typedefs */


/* external subroutines */


/* external variables */


/* local structures */


/* forward references */

template<typename T> consteval T cpow(T b,int e) noex {
    	T ret = 1 ;
	for (int i = 0 ; i < e ; i += 1) {
	    ret *= b ;
	}
	return ret ;
} /* end subroutine-template (cpow) */


