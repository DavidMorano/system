/*******************************************************************************

	Names:
	isourbad
	hasourbad

	Description:
	This object supports the FMTSTR subroutine and the FMTSUB object.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cwchar>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<mkchar.h>		/* LIBU */
#include	<ischarx.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

#include	"fmtstr.h"

export module fmtutil ;

export {
    constexpr cchar	nullstr[] = FMTSTR_NULLSTR ;
    constexpr cint	chx_binary = mkchar('b') ;
    constexpr cint	chx_expand = mkchar('ß') ;
    constexpr cint	chx_badsub = mkchar('¿') ;
} /* end */

export {
    bool hasourbad(cchar *,int) noex ;
    inline bool isourbad(int ch) noex {
    	return (! isprintterm(ch)) ;
    } /* end subroutine */
} /* end export */

export {
    struct numbases {
	static constexpr int	bin	= 2 ;
	static constexpr int	oct	= 8 ;
	static constexpr int	dec	= 10 ;
	static constexpr int	hex	= 16 ;
    } ; /* end struct (numbases) */
} /* end export */

export {
    extern const numbases	numbase ;
} /* end export */

#ifdef	COMMENT
export {
    template<typename T>
    constexpr bool isoneof(int ch,Args ... args) noex {
	(void) args ;
	return false ;
    } /* end subrutine-template */
} /* end export */
#endif /* COMMENT */


