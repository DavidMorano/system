module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */

#include	"dater.h"

export module dater_mag ;

export {
    template<typename ... Args>
    inline int dater_magic(dater *op,Args ... args) noex {
	    int		rs = SR_FAULT ;
	    if (op && (args && ...)) ylikely {
	        rs = (op->magval == DATER_MAGIC) ? SR_OK : SR_NOTOPEN ;
	    }
	    return rs ;
    } /* end subroutine (dater_magic) */
} /* end export */


