/*******************************************************************************

	Module:
	ucstream

	Description:
	This object implements a file stream.

	Symopsis:
	int ucstream_start(int n = 0) noex

	Arguments:
	n		suggested starting possible number of elements

	Returns:
	>=0		ok
	<0		error (system-return)

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<sys/stat.h>		/* POSIX |dev_t| + |ino_t| */
#include	<unistd.h>		/* POSIX */
#include	<fcntl.h>		/* POSIX */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<usysbase.h>		/* LIBU */
#include	<filer.h>		/* LIBUC <- the money shot */

export module ucstream ;

enum ucstreammems {
	ucstreammem_close,
	ucstreammem_overlast
} ; /* end enum (ucstreammems) */

export {
    struct ucstream ;
    struct ucstream_co {
	ucstream	*op = nullptr ;
	int		w = -1 ;
	void operator () (ucstream *p,int m) noex {
	    op = p ;
	    w = m ;
	} ;
	operator int () noex ;
	int operator () () noex {
	    return operator int () ;
	} ;
    } ; /* end struct (ucstream_co) */
    struct ucstream : filer {
	friend		ucstream_co ;
	ucstream_co	close ;
	int		fd ;
	ucstream() noex {
	    close	(this,ucstreammem_close) ;
	    fd = -1 ;
	} ; /* end ctor) */
	int open(cchar *,cchar * = nullptr,mode_t = 0) noex ;
	int start	(int = 0,off_t = 0z,int = 0,int = 0) = delete ;
	int finish	() = delete ;
	void dtor() noex ;
	destruct ucstream() {
	    if (fd >= 0) dtor() ;
	} ; /* end dtor */
    private:
	int	iclose() noex ;
    } ; /* end class (ucstream) */
} /* end export */


