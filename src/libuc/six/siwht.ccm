/*******************************************************************************

  	module:
	siwht

	Description:
	These subroutine searchs for an a character that is either
	the specified character (if provided), or for a character
	in a specified chracter-class (if provided), or failing
	that a white-space character.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* MUST be first to configure */
#include	<cstddef>		/* CSTD |nullptr_t| */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

#pragma		GCC dependency		"mod/chrset.ccm"

export module siwht ;

import chrset ;

export extern "C" {
    int	siwht(cchar *,int) noex ;
    int	siwhtchr(cchar *,int,int) noex ;
    int	siwhtbrk(cchar *,int,cchar *) noex ;
} /* end extern (C) */

export extern "C++" {
    int	siwhtbrk(cchar *,int,con chrset *) noex ;
} /* end extern (C) */


