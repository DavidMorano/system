module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cstdint>		/* CSTD */
#include	<cstdintx>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

#include	"modsys.hh"

export module modsys:intsat ;

export {
   inline int intsati	(cint v)	noex {
	return v ;
   } /* end */
   int intsatl		(clong)		noex ;
   int intsatll		(clonglong)	noex ;
} /* end export */

export {
   int intsatui		(cuint)		noex ;
   int intsatul		(culong)	noex ;
   int intsatull	(culonglong)	noex ;
} /* end export */

export {
    inline int intsat	(cint v)	noex {
	return intsati(v) ;
    } /* end */
    inline int intsat	(clong v)	noex {
	return intsatl(v) ;
    } /* end */
    inline int intsat	(clonglong v)	noex {
	return intsatll(v) ;
    } /* end */
} /* end export */

export {
    inline int intsat	(cuint v)	noex {
	return intsatui(v) ;
    } /* end */
    inline int intsat	(culong v)	noex {
	return intsatul(v) ;
    } /* end */
    inline int intsat	(culonglong v)	noex {
	return intsatull(v) ;
    } /* end */
} /* end export */


