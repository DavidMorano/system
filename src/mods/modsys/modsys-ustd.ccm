/*******************************************************************************

  	Group:
	ustd_confval
	ustd_confstr

	Description:
	This file contains the UNIX® system types that the brain-damaged
	MacOS operating system does NOT have.  We are trying in a
	very small way to make up for some of the immense brain-damage
	within the Apple Darwin operating system.

*******************************************************************************/

module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<usysrets.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */
#include	<sysconfcmds.h>		/* LIBU commands for |sysconf(3c)| */

export module modsys:ustd ;

export {
    int	ustd_confval	(int,long * = nullptr) noex ;
    int	ustd_confstr	(int,char *,int) noex ;
} /* end export */


