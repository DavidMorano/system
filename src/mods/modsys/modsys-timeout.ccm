export module modsys:timeout ;

export {
    enum utos {
	uto_again,
	uto_intr,
	uto_nomem,
	uto_nosr,
	uto_nobufs,
	uto_busy,
	uto_get,
	uto_deadlock,
	uto_io,
	uto_dquot,
	uto_nospc,
	uto_dial,
	uto_open,
	uto_read,
	uto_mfile,
	uto_nfile,
	uto_poll,
	uto_nolck,
	uto_capture,
	uto_txtbusy,
	uto_closewait,
	uto_inprogress,
	uto_overlast
    } ; /* end enum (utos) */
} /* end export */

export {
