module ;

#include	<envstandards.h>	/* ordered first to configure */
#include	<climits>		/* CSTD |INT_MAX| */
#include	<cstddef>		/* CSTD */
#include	<cstdlib>		/* CSTD */
#include	<cstdarg>		/* CSTD */
#include	<cstring>		/* CSTD |strlen(3c)| + |strnlen(3c)| */
#include	<algorithm>		/* C++STD |min(C++)| */
#include	<clanguage.h>		/* LIBU */
#include	<utypedefs.h>		/* LIBU */
#include	<utypealiases.h>	/* LIBU */
#include	<usysdefs.h>		/* LIBU */
#include	<usysrets.h>		/* LIBU */
#include	<localmisc.h>		/* LIBU */

export module modutil:memb ;

import modcstring ;

export {
    constexpr inline int membcpy(void *dp,int dl,cvoid *sp,int sl = -1) noex {
	int		rs = SR_FAULT ;
	int		len = 0 ; /* return-value */
	if (dp && sp) ylikely {
	    rs = SR_INVALID ;
	    if (dl >= 0) ylikely {
		rs = SR_OK ;
	        if (sl < 0) {
	            cchar *cp = charp(sp) ;
		    if consteval {
	                sl = cstrlen(cp) ;
		    } else {
	                sl = intconv(strlen(cp)) ;
		    } /* end if (consteval) */
	        } /* end if (calculate source length) */
	        if (sl > 0) ylikely {
		    rs = SR_OVERFLOW ;
		    if (sl <= dl) ylikely {
			rs = SR_OK ;
			if consteval {
	                    cmemcpy(dp,sp,sl) ;
	                    len = sl ;
			} else {
	            	    csize srcsize = size_t(sl) ;
	                    memcpy(dp,sp,srcsize) ;
	                    len = sl ;
			} /* end if (consteval) */
		    } /* end if (ok) */
	        } /* end block */
	    } /* end if (valid) */
	} /* end if (non-null) */
	return (rs >= 0) ? len : rs ;
    } /* end subroutine (membcpy) */
} /* end export */

export {
    template<typename T>
    constexpr inline void *membcpyz(T *dp,int dl,cvoid *sp,int sl) noex {
	int		rs = SR_FAULT ;
    	int		len = 0 ; /* return-value */
	if (dp && sp) ylikely {
	    rs = SR_INVALID ;
	    if (dl >= 0) ylikely {
	        if (sl < 0) {
	            cchar *cp = ccharp(sp) ;
		    if consteval {
	                sl = cstrlen(cp) ;
		    } else {
	                sl = intconv(strlen(cp)) ;
		    } /* end if (consteval) */
	        } /* end if (calculate source length) */
	        if (sl > 0) ylikely {
		    rs = SR_OVERFLOW ;
		    if (sl <= dl) ylikely {
	                caddr_t	dst = caddr_t(dp) ;
		        rs = SR_OK ;
		        if consteval {
	            	    cmemcpy(dst,sp,sl) ;
	                    len = sl ;
		        } else {
	                    csize srcsize = size_t(sl) ;
		            memcpy(dst,sp,srcsize) ;
	                    len = sl ;
		        } /* end if (consteval) */
		        dst += sl ;
		        if (sl < dl) {
		            csize zsize = size_t(dl - sl) ;
			    if consteval {
		                cmemset(dst,0,int(zsize)) ;
			    } else {
		                memset(dst,0,zsize) ;
			    } /* end if (consteval) */
		        } /* end if (zero-fill) */
		    } /* end if (no-overflow) */
	        } /* end if (non-zero positive) */
	    } /* end if (valid) */
	} /* end if (non-null) */
	return (rs >= 0) ? len : rs ;
    } /* end subroutine (membcpyz) */
} /* end export */

export {
    constexpr inline int membset(void *dp,int dl,int ch = 0,int n = -1) noex {
	int		rs = SR_FAULT ;
	int		rl = -1 ; /* return-value */
	if (dp) ylikely {
	    rs = SR_INVALID ;
	    if (dl >= 0) {
		rs = SR_OVERFLOW ;
		if (n <= dl) {
	            rs = SR_OK ;
		    if (n < 0) n = dl ;
	            char *bp = charp(dp) ;
	            while (n-- > 0) {
		        *bp++ = char(ch) ;
	            } /* end while */
	            rl = intconv(bp - charp(dp)) ;
	        } /* end if (no-overflow) */
	    } /* end if (valid) */
	} /* end if (non-null) */
	return (rs >= 0) ? rl : rs ;
    } /* end subroutine (membset) */
    constexpr inline int memfill(void *dp,int dl,int ch = 0,int n = -1) noex {
	return membset(dp,dl,ch,n) ;
    } /* end subroutine (memfill) */
} /* end export */


